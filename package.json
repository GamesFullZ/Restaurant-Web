{
  "name": "mesa-restaurant-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mesa — restaurante mexicano contemporáneo ficticio. Sitio, reservas con mapa de mesas y panel admin (demo de portafolio).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hash": "tsc --noEmit && VITE_ROUTER=hash vite build --base ./ --outDir dist-hash",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "render:dishes": "node scripts/render-dishes.mjs",
    "build:pages": "tsc --noEmit && vite build --base /Restaurant-Web/ && cp dist/index.html dist/404.html",
    "brand": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
